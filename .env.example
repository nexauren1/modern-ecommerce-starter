# -------------------------
# Private Admin
# -------------------------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-long-random-secret

# -------------------------
# Backend provider
# demo    = no external service
# firebase= Firestore via Firebase Admin
# rest    = any compatible REST/HTTP backend
# -------------------------
BACKEND_PROVIDER=demo

# REST backend (used only when BACKEND_PROVIDER=rest)
BACKEND_API_BASE_URL=
BACKEND_PRODUCTS_PATH=/products
BACKEND_API_KEY_HEADER=Authorization
BACKEND_API_KEY=
BACKEND_BEARER_TOKEN=

# -------------------------
# Firebase Web App (optional)
# -------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (SERVER ONLY, used only with BACKEND_PROVIDER=firebase)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# -------------------------
# Optional service slots
# Keep these values server-side unless a provider explicitly requires a public key.
# -------------------------
STORAGE_PROVIDER=url
PAYMENT_PROVIDER=custom
EMAIL_PROVIDER=custom
AUTH_PROVIDER=admin-session
