# ============================================================
# MODERNCOMMERCE — ENVIRONMENT / SECRETS
# ============================================================

# Admin / security — SERVER ONLY
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-long-random-secret

# Database / data provider
# Supported built-in modes: demo, firebase, rest
DATA_PROVIDER=firebase
DATA_API_BASE_URL=
DATA_API_KEY=
DATA_PRODUCTS_PATH=/products

# Firebase Admin — SERVER ONLY
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Optional Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Storage provider
STORAGE_PROVIDER=custom
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# Payment provider — provider agnostic
PAYMENT_PROVIDER=custom
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_CHECKOUT_PATH=/checkout
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Email / notifications
EMAIL_PROVIDER=custom
EMAIL_API_BASE_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Public app settings
NEXT_PUBLIC_STORE_NAME=ModernCommerce
NEXT_PUBLIC_STORE_URL=http://localhost:3000
