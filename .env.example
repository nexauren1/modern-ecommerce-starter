# ============================================================
# MODERNCOMMERCE — ENVIRONMENT / SECRETS
# Copy this file to .env.local for local development.
# NEVER commit real secrets.
# ============================================================

# ------------------------------------------------------------
# 1) PRIVATE ADMIN AUTHENTICATION — SERVER ONLY
# ------------------------------------------------------------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-long-random-secret

# ------------------------------------------------------------
# 2) DATA / DATABASE PROVIDER
# The app is designed around provider adapters.
# "firebase" is the included adapter; replace DATA_PROVIDER
# and implement your own adapter for another database.
# ------------------------------------------------------------
DATA_PROVIDER=firebase

# Firebase Admin SDK — SERVER ONLY
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Optional Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# 3) STORAGE PROVIDER
# Use these generic variables for S3-compatible/cloud storage.
# ------------------------------------------------------------
STORAGE_PROVIDER=custom
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# ------------------------------------------------------------
# 4) PAYMENT PROVIDER — PROVIDER AGNOSTIC
# PAYMENT_PROVIDER can be "custom" or your adapter name.
# PAYMENT_API_BASE_URL and PAYMENT_API_KEY stay server-only.
# ------------------------------------------------------------
PAYMENT_PROVIDER=custom
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_CHECKOUT_PATH=/checkout
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# ------------------------------------------------------------
# 5) EMAIL / NOTIFICATIONS
# ------------------------------------------------------------
EMAIL_PROVIDER=custom
EMAIL_API_BASE_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ------------------------------------------------------------
# 6) APPLICATION
# ------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=ModernCommerce
NEXT_PUBLIC_STORE_URL=http://localhost:3000
